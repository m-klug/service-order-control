# Supabase — copie para `.env` e preencha com os valores do seu projeto.
# Painel: Project Settings > API
# (o `.env` é ignorado pelo git; nunca versione as chaves reais)

# URL do projeto, ex.: https://xxxxxxxx.supabase.co
VITE_SUPABASE_URL=

# Chave pública (anon/publishable). NÃO use a service_role no frontend.
VITE_SUPABASE_ANON_KEY=
