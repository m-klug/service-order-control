# Copie para .env e preencha. Gere JWT_SECRET/ANON_KEY/SERVICE_ROLE_KEY com:
#   node generate-keys.mjs
# NUNCA versione o .env preenchido — ele fica fora do git (.gitignore).

### Postgres ###
POSTGRES_DB=postgres
POSTGRES_PORT=5432
# Senha do banco. Gere uma forte, ex.: openssl rand -hex 24
POSTGRES_PASSWORD=

### JWT / chaves de API (gerar com `node generate-keys.mjs`) ###
JWT_SECRET=
JWT_EXPIRY=3600
ANON_KEY=
SERVICE_ROLE_KEY=

### URLs externas ###
# Endereço em que o gateway (Kong) fica acessível — IP/hostname do LXC
# na rede local, porta do KONG_HTTP_PORT abaixo. Ex.: http://192.168.1.50:8000
API_EXTERNAL_URL=http://localhost:8000
SITE_URL=http://localhost:8000

### Portas expostas no host ###
KONG_HTTP_PORT=8000
APP_HTTP_PORT=8080

### Studio (login do painel administrativo) ###
DASHBOARD_USERNAME=admin
# Troque por uma senha forte antes de subir em produção.
DASHBOARD_PASSWORD=
STUDIO_DEFAULT_ORGANIZATION=Beto Sistemas
STUDIO_DEFAULT_PROJECT=Controle de OS

### Frontend (embutido no build da imagem — ver docker/app/Dockerfile) ###
# Mesma URL do API_EXTERNAL_URL e a mesma ANON_KEY acima.
VITE_SUPABASE_URL=http://localhost:8000
VITE_SUPABASE_ANON_KEY=
